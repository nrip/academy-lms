{
    "name": "academy/lms",
    "description": "Academy LMS — Continuing Medical Education platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-sodium": "*",
        "dompdf/dompdf": "^3.1",
        "laminas/laminas-diactoros": "^3.5",
        "laminas/laminas-httphandlerrunner": "^2.11",
        "league/route": "^7.0",
        "monolog/monolog": "^3.8",
        "php-di/php-di": "^7.0",
        "psr/container": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "robmorgan/phinx": "^0.16",
        "smalot/pdfparser": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "Academy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Academy\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "php -d upload_max_filesize=10M -d post_max_size=16M vendor/bin/phpunit",
        "phpstan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "assets:install": "node bin/install-frontend-assets.mjs",
        "setup": "php bin/setup.php",
        "setup-uat": "php bin/setup.php --seed-uat",
        "migrate": "php vendor/bin/phinx migrate -c phinx.php",
        "uat-seed": "php bin/jobs.php uat:seed",
        "uat-reset": "php bin/jobs.php uat:reset --confirm",
        "demo-prepare": "php -d upload_max_filesize=10M -d post_max_size=16M bin/jobs.php demo:prepare --confirm",
        "demo-process": "php -d upload_max_filesize=10M -d post_max_size=16M bin/jobs.php demo:process",
        "demo-serve": "bash bin/demo-server.sh"
    }
}
