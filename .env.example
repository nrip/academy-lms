APP_NAME="Academy LMS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
# Optional build metadata (injected by CI/CD; safe to expose)
APP_VERSION=0.0.0-dev
GIT_SHA=
BUILD_TIME=

# Single-deployment academy branding (Phase 1; no multi-tenancy / admin UI)
# ACADEMY_NAME defaults to APP_NAME when unset
ACADEMY_NAME="Academy LMS"
ACADEMY_LOGO_URL=/assets/brand/logo.svg
ACADEMY_PRIMARY_COLOR=#0F6E62
ACADEMY_SUPPORT_EMAIL=
# Defaults to ACADEMY_NAME when unset
ACADEMY_CERTIFICATE_ISSUER_NAME="Academy LMS"

# Comma-separated proxy IPs, or blank to disable trusted-proxy handling
TRUSTED_PROXIES=
FORCE_HTTPS=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=academy_lms
DB_USER=academy
DB_PASSWORD=
DB_CHARSET=utf8mb4

LOG_LEVEL=debug
LOG_PATH=storage/logs/app.log

# Session / rate-limit / outbox (WP-01A)
RATE_LIMIT_PEPPER=change-me-in-production
SESSION_COOKIE_SECURE=false
SESSION_ACTIVITY_THROTTLE_SECONDS=300
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
SESSION_PRIVILEGED_IDLE_SECONDS=900
SESSION_PRIVILEGED_ABSOLUTE_SECONDS=28800
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE_SECONDS=5
OUTBOX_BACKOFF_CAP_SECONDS=3600
# unconfigured | memory (memory only for local/testing/ci/uat)
OUTBOX_TRANSPORT=unconfigured

# WP-01B-2a notification / verification crypto
TOKEN_PEPPER=change-me-token-pepper
OTP_PEPPER=change-me-otp-pepper-different
# 32-byte key, strict base64 — generate locally; never commit a real key
NOTIFICATION_DELIVERY_KEY=
NOTIFICATION_DELIVERY_KEY_PREVIOUS=
NOTIFICATION_DELIVERY_KEY_VERSION=1
TOKEN_CONFIRMATION_CONTEXT_TTL_SECONDS=900
TOKEN_CONFIRMATION_CLEANUP_RETENTION_DAYS=7
TOKEN_CONFIRMATION_CLEANUP_BATCH_SIZE=1000
# recording | local_file | unavailable (recording/local_file forbidden in staging/production)
NOTIFICATION_EMAIL_ADAPTER=
NOTIFICATION_SMS_ADAPTER=
NOTIFICATION_LOCAL_MAIL_PATH=storage/mail

# Production SMTP (Amazon SES SMTP or any SMTP). When MAIL_DRIVER=smtp|ses, overrides NOTIFICATION_EMAIL_ADAPTER.
# MAIL_DRIVER=
# MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=noreply@example.com
# MAIL_FROM_NAME="Academy LMS"

# WP-01B-2b registration legal acceptance versions
TERMS_VERSION=2026-07-22
PRIVACY_VERSION=2026-07-22

# Documents / storage / scanner (WP-03)
# Application credential document cap is 10 MB. Local PHP must allow at least:
#   upload_max_filesize=10M
#   post_max_size=16M
# Prefer: composer demo-serve   (or bin/demo-server.sh)
DOCUMENTS_DECLARATION_VERSION=2026-07-22
DOCUMENTS_UPLOAD_TTL_SECONDS=900
DOCUMENTS_DOWNLOAD_TTL_SECONDS=900
DOCUMENTS_STUCK_SCAN_SLA_SECONDS=900
DOCUMENTS_STUCK_SCAN_MAX_ATTEMPTS=5
DOCUMENTS_SCAN_LEASE_SECONDS=60
# local | unconfigured (local only for local/testing/ci/uat)
DOCUMENTS_STORAGE_DRIVER=
DOCUMENTS_LOCAL_BASE_PATH=storage/documents
DOCUMENTS_LOCAL_SIGNING_SECRET=change-me-documents-signing-secret
# Explicit fake scanner — default on for testing/ci only
DOCUMENTS_FAKE_SCANNER=

# Learning media (separate from credential documents). local | s3. Both are private.
# Local is allowed in every environment. Never point this at public/.
LEARNING_STORAGE_DRIVER=local
LEARNING_LOCAL_BASE_PATH=storage/learning-media
LEARNING_LOCAL_SIGNING_SECRET=change-me-learning-media-signing-secret
# Platform downloadable-resource cap until a lecture-video cap is confirmed. 104857600 = 100 MB.
LEARNING_MEDIA_MAX_BYTES=104857600
LEARNING_S3_BUCKET=
LEARNING_S3_REGION=
LEARNING_S3_ACCESS_KEY_ID=
LEARNING_S3_SECRET_ACCESS_KEY=
LEARNING_S3_ENDPOINT=

# WP-05 payment checkout (Razorpay). Fake gateway only for local|testing|ci|uat with explicit flag.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Empty = default on for testing/ci, off otherwise. Never enable in staging/production.
PAYMENTS_FAKE_GATEWAY=
PAYMENTS_RECONCILE_PENDING_STALE_SECONDS=1800

# Local Super Admin bootstrap (local|testing only; never production)
ALLOW_LOCAL_BOOTSTRAP_ADMIN=false
BOOTSTRAP_ADMIN_EMAIL=
# Prefer BOOTSTRAP_ADMIN_PASSWORD_HASH; plaintext only under local gates
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD_HASH=
BOOTSTRAP_ADMIN_MOBILE=+910000000000

# UAT seed password (local|testing|ci|uat). Do not use in production.
UAT_SEED_PASSWORD=
